# DisasterGuard Environment Configuration

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# JWT Secret for Session & Admin Authentication
JWT_SECRET=disasterguard_demo_jwt_secret_key_change_in_production_2026

# Development / Demonstration Admin Credentials (Used when demonstration mode is enabled)
DEMO_ADMIN_EMAIL=admin@disasterguard.org
DEMO_ADMIN_PASSWORD=admin123
ENABLE_DEMO_LOGIN=true

# MongoDB Connection String (Optional)
# If MongoDB is running locally or via Atlas, uncomment and configure below.
# If unavailable or commented out, DisasterGuard automatically operates in Local Demonstration Mode using persistent JSON storage.
# MONGODB_URI=mongodb://localhost:27017/disasterguard
